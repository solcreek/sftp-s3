S3_BUCKET=my-bucket
AWS_REGION=us-east-1
# S3_PREFIX=sftp/
# S3_ENDPOINT=https://storage.googleapis.com
# About 120 MiB of memory per concurrent large upload; keep it in line with
# the memory limit in deployment.yaml (512Mi -> 3).
SFTP_MAX_CONNECTIONS=3
# One JSON object per log line, for the cluster's log collector.
SFTP_LOG_FORMAT=json
